<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>WarpCLR.CSharp</PackageId>
    <Description>C# SDK for the WarpCLR 0.1.0 profile.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.IR\WarpCLR.IR.csproj" />
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.Runtime.Device\WarpCLR.Runtime.Device.csproj" />
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.Runtime.Host\WarpCLR.Runtime.Host.csproj" />
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.Sdk\WarpCLR.Sdk.csproj" />
    <ProjectReference Include="..\WarpCLR.CSharp.Analyzers\WarpCLR.CSharp.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WarpCLR.CSharp.Build\WarpCLR.CSharp.Build.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WarpCLR.CSharp.Generators\WarpCLR.CSharp.Generators.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\WarpCLR.CSharp.Analyzers\bin\$(Configuration)\netstandard2.0\WarpCLR.CSharp.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\WarpCLR.CSharp.Generators\bin\$(Configuration)\netstandard2.0\WarpCLR.CSharp.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\WarpCLR.CSharp.Build\bin\$(Configuration)\net10.0\WarpCLR.CSharp.Build.deps.json" Pack="true" PackagePath="tools/net10.0/any" Visible="false" />
    <None Include="..\WarpCLR.CSharp.Build\bin\$(Configuration)\net10.0\WarpCLR.CSharp.Build.dll" Pack="true" PackagePath="tools/net10.0/any" Visible="false" />
    <None Include="..\WarpCLR.CSharp.Build\bin\$(Configuration)\net10.0\WarpCLR.CSharp.Build.runtimeconfig.json" Pack="true" PackagePath="tools/net10.0/any" Visible="false" />
    <None Include="..\WarpCLR.CSharp.Build\bin\$(Configuration)\net10.0\WarpCLR.IR.dll" Pack="true" PackagePath="tools/net10.0/any" Visible="false" />
    <None Include="..\WarpCLR.CSharp.Build\bin\$(Configuration)\net10.0\WarpCLR.Verifier.dll" Pack="true" PackagePath="tools/net10.0/any" Visible="false" />
    <None Include="build\WarpCLR.CSharp.targets" Pack="true" PackagePath="build" Visible="false" />
  </ItemGroup>
