<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="MSTest.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\WarpCLR.CSharp.Testing\FourBackendsAttribute.cs" Link="Testing\FourBackendsAttribute.cs" />
    <Compile Include="..\WarpCLR.CSharp.Testing\RoslynCompilationFactory.cs" Link="Testing\RoslynCompilationFactory.cs" />
    <ProjectReference Include="..\WarpCLR.CSharp\WarpCLR.CSharp.csproj" />
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.IR\WarpCLR.IR.csproj" />
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.Runtime.Host\WarpCLR.Runtime.Host.csproj" />
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.Sdk\WarpCLR.Sdk.csproj" />
    <ProjectReference Include="$(WarpClrRepositoryRoot)\WarpCLR.Verifier\WarpCLR.Verifier.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="WarpCLR.CSharp.Testing" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WarpCLR.CSharp.RepositoryRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
